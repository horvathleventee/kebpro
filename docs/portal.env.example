# Separate from the existing website DATABASE_URL. Never commit real values.
# No value = existing local SQLite preview. A configured but failing PG never falls back.
PORTAL_DATABASE_URL=postgresql://portal_user:REPLACE@localhost:5432/kebpro_portal
# Use a provider-verified TLS connection for remote PG; do not disable certificate checks.
# PORTAL_DATABASE_URL=postgresql://.../kebpro_portal?sslmode=verify-full
PORTAL_PUBLIC_ORIGIN=http://localhost:3002
PORTAL_BACKUP_DIR=D:/kebpro/data/backups
# Enable monitoring only after entering the real recipient and a long random token.
PORTAL_ALERT_EMAIL=
PORTAL_MONITOR_TOKEN=
PORTAL_MONITOR_URL=http://localhost:3002/partner/health
PORTAL_MONITOR_STATE=D:/kebpro/data/monitor-state.json
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS and MAIL_FROM
# are reused from the existing website configuration by portal/mailer.js.
# Optional integration tests: disposable database, with no kebpro_portal schema.
PORTAL_TEST_DATABASE_URL=
