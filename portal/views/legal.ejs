<!doctype html><html lang="hu"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= doc.title %></title><link rel="stylesheet" href="/partner/assets/portal.css"></head>
<body><main class="legal-document"><a href="/partner/login">← Vissza a partnerfelületre</a><h1><%= doc.title %></h1><% if(doc.version.startsWith("draft-")){ %><p class="notice warning">Korábbi dokumentumtervezet.</p><% } %><p class="small muted">Dokumentumváltozat: <%= doc.version %></p><% for(const [title,body] of doc.sections){ %><section class="card section-gap"><h2><%= title %></h2><p><%= body %></p></section><% } %><% if(doc.title === "Partnerfelület adatkezelési tájékoztatója"){ %><p><a href="/adatkezelesi-tajekoztato" target="_blank" rel="noopener">A weboldal adatkezelési tájékoztatója</a></p><% } %></main></body></html>
