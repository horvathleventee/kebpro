<%- include('partials/header') %>

<section class="page-hero section-animate">
  <div class="container">
    <p class="eyebrow"><%= t.quote.eyebrow %></p>
    <h1><%= t.quote.title %></h1>
  </div>
</section>

<section class="section section-animate">
  <div class="container">
    <div class="panel wide">
      <% if (successMessage) { %>
      <div class="success-toast" data-success-toast>
        <div class="success-toast-icon" aria-hidden="true">📞</div>
        <div>
          <strong><%= successMessage %></strong>
          <span><%= t.forms.quoteSuccessNote %></span>
        </div>
        <div class="success-toast-progress"></div>
      </div>
      <% } %>

      <% const initialProducts = formData.products && formData.products.length ? formData.products : [{ product: formData.product || '', quantity: formData.quantity || '' }]; %>
      <form method="POST" action="<%= withLang('/ajanlatkeres') %>" class="contact-form" novalidate>
        <div class="form-brand" aria-hidden="true">
          <img src="/images/optimized/logo-85.png?v=<%= assetVersion || 'local' %>" alt="" width="46" height="21" style="width:46px;max-width:46px;height:auto;" loading="lazy" decoding="async" />
        </div>
        <p class="form-required-hint"><%= t.forms.requiredHint %></p>
        <% if (Object.keys(errors).length) { %>
        <div class="form-error-summary" role="alert" tabindex="-1" data-form-errors><strong><%= lang === 'en' ? 'Please check the highlighted fields.' : lang === 'de' ? 'Bitte prüfen Sie die markierten Felder.' : 'Kérjük, ellenőrizze a jelölt mezőket.' %></strong></div>
        <% } %>

        <label for="name"><%= t.forms.name %> <span class="required-mark">*</span></label>
        <input id="name" name="name" autocomplete="name" aria-required="true" <%- errors.name ? 'aria-invalid="true" aria-describedby="error-name"' : '' %> type="text" value="<%= formData.name || '' %>" />
        <% if (errors.name) { %><small class="error" id="error-name"><%= errors.name %></small><% } %>

        <label for="company"><%= t.forms.company %> <span class="required-mark">*</span></label>
        <input id="company" name="company" autocomplete="organization" aria-required="true" <%- errors.company ? 'aria-invalid="true" aria-describedby="error-company"' : '' %> type="text" value="<%= formData.company || '' %>" />
        <% if (errors.company) { %><small class="error" id="error-company"><%= errors.company %></small><% } %>

        <label for="email"><%= t.forms.email %> <span class="required-mark">*</span></label>
        <input id="email" name="email" autocomplete="email" aria-required="true" <%- errors.email ? 'aria-invalid="true" aria-describedby="error-email"' : '' %> type="email" value="<%= formData.email || '' %>" />
        <% if (errors.email) { %><small class="error" id="error-email"><%= errors.email %></small><% } %>

        <label for="phone"><%= t.forms.phone %> <span class="required-mark">*</span></label>
        <input id="phone" name="phone" autocomplete="tel" aria-required="true" <%- errors.phone ? 'aria-invalid="true" aria-describedby="error-phone"' : '' %> type="tel" value="<%= formData.phone || '' %>" />
        <% if (errors.phone) { %><small class="error" id="error-phone"><%= errors.phone %></small><% } %>

        <div class="order-products-builder" data-order-products>
          <label><%= t.forms.productInterest %> <span class="required-mark">*</span></label>
          <div class="order-product-rows" data-order-product-rows>
            <% initialProducts.forEach((initialProduct) => { %>
            <div class="order-product-row">
              <select name="products" class="status-select order-product-select" aria-label="<%= t.forms.selectProduct %>" <%- errors.product ? 'aria-invalid="true" aria-describedby="error-product"' : '' %>>
                <option value=""><%= t.forms.selectProduct %></option>
                <% (productOptions || []).forEach((option) => { %>
                <option value="<%= option.value %>" <%= initialProduct.product === option.value ? 'selected' : '' %>><%= option.label %></option>
                <% }) %>
              </select>
              <input name="productQuantities" type="text" aria-label="<%= t.forms.quantity %>" <%- errors.quantity ? 'aria-invalid="true" aria-describedby="error-quantity"' : '' %> placeholder="<%= t.forms.estimatedQuantity %>" value="<%= initialProduct.quantity || '' %>" />
              <button type="button" class="btn btn-secondary order-remove-product" aria-label="<%= t.forms.removeProduct %>">×</button>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn btn-secondary order-add-product" data-add-order-product><%= t.forms.addProduct %></button>
        </div>
        <input id="product" name="product" type="hidden" value="<%= formData.product || '' %>" />
        <% if (errors.product) { %><small class="error" id="error-product"><%= errors.product %></small><% } %>

        <label for="quantity" class="visually-hidden"><%= t.forms.estimatedQuantity %></label>
        <input id="quantity" name="quantity" type="hidden" value="<%= formData.quantity || '' %>" />

        <label for="message"><%= t.forms.message %></label>
        <textarea id="message" name="message" rows="5"><%= formData.message || '' %></textarea>
        <% if (errors.message) { %><small class="error"><%= errors.message %></small><% } %>

        <button type="submit" class="btn btn-primary"><%= t.buttons.submitQuote %></button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

