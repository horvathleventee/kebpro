<%- include('partials/header') %>

<section class="environment-page" aria-labelledby="environment-title">
  <div class="container environment-container">
    <div class="environment-intro">
      <div class="environment-symbol" aria-hidden="true">
        <svg viewBox="0 0 80 80" fill="none" width="80" height="80">
          <path d="M57 16C38 16 20 24 20 42c0 12 9 20 20 20 19 0 23-25 17-46Z" fill="currentColor" opacity=".12" />
          <path d="M57 16C38 16 20 24 20 42c0 12 9 20 20 20 19 0 23-25 17-46Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M22 67c5-17 15-31 29-42M31 47l-2-12m10 2 11 1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </div>
      <p class="eyebrow"><%= t.environment.eyebrow %></p>
      <h1 id="environment-title"><%= t.environment.title %></h1>
      <p class="environment-lead"><%= t.environment.lead %></p>
    </div>
    <section aria-labelledby="environment-documents-title">
      <h2 class="environment-section-title" id="environment-documents-title"><%= t.environment.documentsTitle %></h2>
      <div class="environment-documents">
        <% t.environment.documents.forEach((document) => { %>
        <article class="environment-document" aria-labelledby="document-<%= document.id %>">
          <div class="environment-document-top">
            <span class="environment-document-icon" aria-hidden="true">
              <svg width="28" height="34" viewBox="0 0 28 34" fill="none">
                <path d="M5 1h12l8 8v22a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="M17 1v8h8M8 17h12M8 22h12M8 27h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <time datetime="<%= document.date %>"><%= document.dateLabel %></time>
          </div>
          <h3 id="document-<%= document.id %>"><%= document.title %></h3>
          <p class="environment-description"><%= document.description %></p>
          <div class="environment-document-details">
            <p><%= t.environment.issuer %></p>
            <p class="environment-document-metadata"><%= t.environment.metadata %></p>
            <div class="environment-document-actions">
              <a class="btn btn-primary" href="<%= document.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= document.title %> — <%= t.environment.open %> (<%= t.environment.newTab %>)"><%= t.environment.open %><span aria-hidden="true">↗</span></a>
              <a class="btn btn-secondary" href="<%= document.url %>" download aria-label="<%= document.title %> — <%= t.environment.download %>"><%= t.environment.download %><span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <p class="environment-note"><%= t.environment.note %></p>
    </section>
    <div class="environment-contact">
      <p><%= t.environment.help %></p>
      <a href="<%= withLang('/kapcsolat') %>"><%= t.environment.contact %><span aria-hidden="true"> →</span></a>
    </div>
    <a class="environment-back" href="<%= withLang('/') %>"><span aria-hidden="true">← </span><%= t.environment.home %></a>
  </div>
</section>

<%- include('partials/footer') %>
